# LLM provider — configure at least one
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
HF_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=

# Local providers
OLLAMA_BASE_URL=http://localhost:11434
LMSTUDIO_BASE_URL=http://localhost:1234

# Snowflake — use a least-privilege read-only role
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=PUBLIC
SNOWFLAKE_ROLE=READ_ONLY_ROLE

# RAG
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=text-embedding-3-small
RAG_CACHE_THRESHOLD=0.90
RAG_SCHEMA_TOP_K=5
RAG_FEW_SHOT_TOP_K=3

# Query limits
MAX_QUERY_ROWS=5000
